# -----------------------------------------------------------------------------
# Rust build outputs
# -----------------------------------------------------------------------------
/target/
/target-*/
/external/libp2p-webrtc/target/
/debug/
/release/

# Cargo temporary/output artifacts
**/*.rs.bk
*.rlib
*.rmeta
*.profraw

# Keep Cargo.lock for this repo.
# This is important for reproducible validation.
!Cargo.lock

# -----------------------------------------------------------------------------
# Full-validation / local test artifacts
# -----------------------------------------------------------------------------
/full-validation/
/target/full-validation/
/validation-output/
/validation-logs/
/test-output/
/test-results/

*.long-type-*.txt

# -----------------------------------------------------------------------------
# Coverage / profiling
# -----------------------------------------------------------------------------
/coverage/
/tarpaulin-report.html
/cobertura.xml
/lcov.info
/*.profdata
/*.profraw

# -----------------------------------------------------------------------------
# Local runtime state
# -----------------------------------------------------------------------------
/data/
/state/
/storage/
/db/
/tmp/
/temp/
/cache/
/logs/

*.log
*.pid
*.sock

# -----------------------------------------------------------------------------
# Local node / identity / secret material
# -----------------------------------------------------------------------------
# Do not commit real node identities, private keys, local configs, or backups.
*.key
*.keys
*.pem
*.der
*.p12
*.pfx
*.seed
*.secret
*.secrets
*.backup
*.bak

identity.json
identity.key
peer-id.txt
node-key*
swarm-key*
private-key*
secret-key*

# Keep examples/templates/docs.
!*.example
!*.example.*
!examples/**
!docs/**

# -----------------------------------------------------------------------------
# Local config files
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example

config.local.*
*.local.json
*.local.toml
*.local.yaml
*.local.yml

node-config.json
node-config.local.json

# Keep example config files.
!examples/*.json
!examples/*.toml
!examples/*.yaml
!examples/*.yml
!examples/**/*.json
!examples/**/*.toml
!examples/**/*.yaml
!examples/**/*.yml

# -----------------------------------------------------------------------------
# Generated archives / patches / release bundles
# -----------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.patch

# -----------------------------------------------------------------------------
# Dependency/vendor policy
# -----------------------------------------------------------------------------
# Do NOT ignore external/. This repo intentionally carries audited companion/third-party source.
!/external/
!/external/**

# Re-assert generated Cargo state after the external-source unignore rules above.
# Package validation must never turn build output or a standalone dependency
# lockfile into a canonical release input.
/external/**/target/
/external/**/Cargo.lock

# -----------------------------------------------------------------------------
# IDE/editor files
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/

# -----------------------------------------------------------------------------
# Windows files
# -----------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# PowerShell transcripts / local history
PowerShell_transcript*.txt
*.ps1xml

# -----------------------------------------------------------------------------
# macOS files
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*

# -----------------------------------------------------------------------------
# Linux files
# -----------------------------------------------------------------------------
.directory
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# Misc generated files
# -----------------------------------------------------------------------------
.*/
# The workspace Cargo config is release-critical: it pins only Cargo's
# resolution-only libp2p DNS/mDNS entries to the audited local placeholders.
!/.cargo/
!/.cargo/config.toml
*.tmp
*.temp
*.orig
*.rej
*.old
*.new

# Local node identities and caches
.p2p-net-identity-key
.p2p-net-peer-cache.json
p2p-node.json
p2p-node-panic.log
/.-identity-key
/.-peer-cache.json

# Canonical release outputs
/dist/

# Android local/generated build state
/apps/android/local.properties
/apps/android/app/src/main/jniLibs/
/apps/android/app/.cxx/
/apps/android/app/build/
/apps/android/build/
apps/android/qa/evidence/

# Machine-generated durable validation evidence (kept locally, not committed)
/qa/evidence/runs/
