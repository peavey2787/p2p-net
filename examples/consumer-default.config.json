{
  "profile": "full",
  "network_id": 7001,
  "heartbeat_interval_secs": 30,
  "gossipsub_heartbeat_interval_secs": 5,
  "ping_interval_secs": 15,
  "startup_peer_cache_probe": 5,
  "identity_key_path": "state/consumer-node.identity.hex",
  "listen_addresses": [
    "/ip4/0.0.0.0/udp/4001/quic-v1",
    "/ip4/0.0.0.0/udp/4003/webrtc-direct",
    "/ip4/0.0.0.0/tcp/4001",
    "/ip4/0.0.0.0/tcp/4002/ws"
  ],
  "listeners": {
    "tcp": true,
    "quic": true,
    "websocket": true,
    "webrtc_direct": true
  },
  "bootstrap_peers": [],
  "relay_peers": [],
  "reserve_configured_relays": true,
  "connection_limits": {
    "enabled": true,
    "max_pending_incoming": 32,
    "max_pending_outgoing": 32,
    "max_established_incoming": 64,
    "max_established_outgoing": 64,
    "max_established": 128,
    "max_established_per_peer": 3,
    "max_established_per_ip": 8
  },
  "discovery": {
    "peer_cache_path": "state/consumer-peer-cache.json",
    "bootstrap_seed_peers": [],
    "rendezvous_peers": [],
    "rendezvous": {
      "client_enabled": true,
      "server_enabled": false,
      "namespace": "p2p-net",
      "register": true,
      "discover": true,
      "register_ttl_secs": 7200,
      "discover_limit": 64
    },
    "namespace": {
      "app_id": "hydra-msg",
      "tags": [
        "contacts:v1",
        "inbox-resurrection:v1"
      ],
      "privacy": "hashed",
      "allow_readable_tags": false
    },
    "dht": {
      "enabled": true,
      "announce": true,
      "discover": true,
      "discover_with_rendezvous_peers": true,
      "refresh_interval_secs": 300,
      "periodic_bootstrap_interval_secs": 300,
      "query_parallelism": 3,
      "max_namespaces_per_refresh": 16,
      "provider_key_replicas": 3
    },
    "relay_discovery": {
      "enabled": true,
      "use_configured_relays": true,
      "use_cached_relays": true,
      "use_rendezvous_relays": true,
      "min_reservations": 3,
      "max_reservations": 8,
      "prefer_configured_relays": true,
      "replace_failed_relays": true
    },
    "public_bootstrap": {
      "mode": "fallback_only",
      "bootstrap_seed_peers": [
        "/dnsaddr/bootstrap.libp2p.io/p2p/QmNnooDu7bfjPFoTZYxMNLWUQJyrVwtbZg5gBMjTezGAJN",
        "/dnsaddr/bootstrap.libp2p.io/p2p/QmQCU2EcMqAqQPR2i9bChDtGNJchTbq5TbXJJ16u19uLTa",
        "/dnsaddr/bootstrap.libp2p.io/p2p/QmbLHAnMoJPWSCR5Zhtx6BHJX9KiKNN6tpvbUcqanj75Nb",
        "/dnsaddr/bootstrap.libp2p.io/p2p/QmcZf59bWwK5XFi76CZX8cbJ4BhTzzA3gU1ZjYZcYW3dwt"
      ],
      "rendezvous_peers": [],
      "relay_peers": [],
      "auto_connect_discovered_peers": true
    }
  },
  "dnsaddr": {
    "enabled": true,
    "doh_endpoint": "https://cloudflare-dns.com/dns-query",
    "timeout_secs": 5
  },
  "dcutr": {
    "enabled": true,
    "attempt_after_relay_connection": true,
    "keep_relay_fallback": true,
    "retry_interval_secs": 60,
    "max_attempts_per_peer": 3
  },
  "public_ip_probe": {
    "enabled": true,
    "endpoints": [
      "https://api.ipify.org",
      "https://checkip.amazonaws.com",
      "https://ifconfig.me/ip"
    ],
    "timeout_secs": 2,
    "advertise_listen_addresses": true
  }
}
