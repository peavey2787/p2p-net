{
  "browser_webrtc": {
    "enabled": true,
    "ice_transport_policy": "all",
    "direct_connections": true,
    "stun": {
      "enabled": true,
      "servers": ["stun:stun.cloudflare.com:3478"]
    }
  },
  "turn": {
    "client": {
      "enabled": true,
      "auto_discover": true,
      "providers": ["libp2p", "self_hosted", "cloudflare"],
      "servers": [
        {
          "urls": ["turn:turn.example.org:3478?transport=udp", "turns:turn.example.org:443?transport=tcp"],
          "username": "browser-guest",
          "credential": "low-privilege-guest-password"
        }
      ],
      "cloudflare": { "url": "https://p2p-net-turn.YOUR_ACCOUNT.workers.dev/ice-servers" },
      "max_servers": 4
    }
  }
}
